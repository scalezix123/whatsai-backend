# ============================================
# Redis Configuration (for Bull job queues)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Feature Flags - Phase 1 MVP Implementation
# ============================================
# Stage 0: Architecture Hardening (always on)

# Stage 1: WhatsApp Reliability & Integration
FEATURE_WEBHOOK_SIGNATURE=false       # Enable webhook signature verification
FEATURE_WEBHOOK_DEDUP=false          # Enable webhook deduplication
FEATURE_WEBHOOK_LOGGING=true         # Enable webhook event logging (default on)

# Stage 2: CRM Foundation
FEATURE_DUPLICATE_DETECTION=false    # Enable duplicate contact detection
FEATURE_CONSENT_MANAGEMENT=false     # Enable opt-in/opt-out compliance
FEATURE_BULK_IMPORT=false            # Enable CSV import with batch processing
FEATURE_CUSTOM_ATTRIBUTES=false      # Enable custom contact attributes

# Stage 3: Template Hardening
FEATURE_TEMPLATE_VALIDATION=false    # Enable template parameter validation
FEATURE_TEMPLATE_VARIABLE_MAPPING=false # Enable template variable extraction

# Stage 4: Campaign Queue System
FEATURE_CAMPAIGN_QUEUE=false         # Use queue-based dispatch instead of direct send
FEATURE_AUTOMATIC_RETRY=false        # Enable automatic message retry
FEATURE_CAMPAIGN_SCHEDULING=false    # Enable campaign scheduling

# Stage 5: Inbox Consistency
FEATURE_ASSIGNMENT_RULES=false       # Enable conversation assignment rules
FEATURE_LEAD_SYNC=false              # Enable lead-conversation synchronization
FEATURE_CONVERSATION_TIMELINE=false  # Enable conversation timeline events

# Stage 6: RBAC + Operational Logs
FEATURE_RBAC=false                   # Enable role-based access control
FEATURE_API_LOGGING=false            # Enable API request logging
FEATURE_AUDIT_LOGS=false             # Enable audit log for sensitive actions

# ============================================
# Logging & Debugging
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Database (Prisma)
# ============================================
# DATABASE_URL is set in .env.local (not committed)

# ============================================
# Meta/WhatsApp API Configuration
# ============================================
# META_APP_ID, META_APP_SECRET, META_BUSINESS_ID set in .env.local

# ============================================
# Supabase Authentication
# ============================================
# SUPABASE_URL, SUPABASE_ANON_KEY set in .env.local
DATABASE_URL="postgres://7aead2c35827fa6a055b08b353a0f5e5c41067079d224307f5fa3ef559e7c4d3:sk_O-xDw-sdK3TGlPD1-YqTS@pooled.db.prisma.io:5432/postgres?sslmode=require"
