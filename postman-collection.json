      "name": "Auth Module",
      "item": [
        {
          "name": "Signup - Valid Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3001/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "Signup - Invalid Password (Too Short)",
